# Salin ke .env.local lalu isi nilainya. Jangan pernah commit .env.local.

# PostgreSQL lokal
DATABASE_URL=postgresql://user:password@localhost:5432/financeapp

# Kunci penandatangan sesi. WAJIB — aplikasi menolak jalan tanpa ini.
# Buat dengan: openssl rand -base64 48
SESSION_SECRET=

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://cuan.bitkonek.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP — dipakai untuk email pemulihan kata sandi.
# Tanpa ini halaman lupa kata sandi menolak jalan (bukan diam-diam gagal).
# Uji dengan: npm run check-smtp -- alamat@tujuan.com
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=email kamu,
#        SMTP_PASS=App Password (bukan sandi akun; butuh 2FA aktif).
# Port 465 dipakai kalau mau TLS langsung, 587 untuk STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
